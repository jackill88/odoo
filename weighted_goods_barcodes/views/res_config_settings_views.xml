<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_weighted_goods" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.weighted.goods</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='barcode_scanner']" position="after">
                <setting string="Weighted goods addon" help="Configure the weighted goods barcode prefix for this PoS.">
                    <div class="row">
                        <label class="col-lg-4 o_light_label" string="Weighted barcode prefix" for="pos_weighted_goods_barcode_prefix"/>
                        <field name="pos_weighted_goods_barcode_prefix" class="col"/>
                    </div>
                    <div class="row">
                        <label class="col-lg-4 o_light_label" string="Weighted goods filter" for="pos_weighted_goods_filter_id"/>
                        <field name="pos_weighted_goods_filter_id" class="col"/>
                    </div>
                    <div class="row">
                        <label class="col-lg-4 o_light_label" string="Scales service IP" for="pos_digital_scales_service_ip_address"/>
                        <field name="pos_digital_scales_service_ip_address" class="col"/>
                    </div>
                    <div class="row">
                        <label class="col-lg-4 o_light_label" string="Scales service port" for="pos_digital_scales_service_port"/>
                        <field name="pos_digital_scales_service_port" class="col"/>
                    </div>
                    <div class="row">
                        <label class="col-lg-4 o_light_label" string="Scales service API key" for="pos_digital_scales_service_api_key"/>
                        <field name="pos_digital_scales_service_api_key" class="col" widget="password"/>
                    </div>
                    <div class="row mt-2">
                        <button class="btn btn-primary" name="action_upload_weighted_goods_to_scales" type="object">
                            Upload weighted PLUs to scales
                        </button>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
