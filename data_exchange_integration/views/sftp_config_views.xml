<odoo>

    <!-- LIST VIEW -->
    <record id="view_sftp_config_list" model="ir.ui.view">
        <field name="name">data.import.sftp.config.list</field>
        <field name="model">data.import.sftp.config</field>
        <field name="arch" type="xml">
            <list string="SFTP Configurations">
                <field name="name"/>
                <field name="key"/>
                <field name="host"/>
                <field name="port"/>
                <field name="username"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_sftp_config_form" model="ir.ui.view">
        <field name="name">data.import.sftp.config.form</field>
        <field name="model">data.import.sftp.config</field>
        <field name="arch" type="xml">
            <form string="SFTP Configuration">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="key"/>
                    </group>

                    <group string="Connection">
                        <field name="host"/>
                        <field name="port"/>
                        <field name="username"/>
                        <field name="password" password="True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_sftp_config" model="ir.actions.act_window">
        <field name="name">SFTP Configurations</field>
        <field name="res_model">data.import.sftp.config</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>