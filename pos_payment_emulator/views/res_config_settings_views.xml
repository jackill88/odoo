<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_pos_payment_emulator" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_payment_emulator</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_terminals_section']" position="inside">
                <setting id="pos_payment_emulator_setting"
                         string="Terminal Emulator"
                         help="Use a simulated payment terminal for testing and demos.">
                    <field name="module_pos_payment_emulator"/>
                    <button name="open_payment_method_form"
                            icon="oi-arrow-right"
                            type="object"
                            string="Payment method"
                            class="btn-link"
                            context="{'selection': 'emulator', 'config_ids': [pos_config_id], 'provider_name': 'Terminal Emulator'}"
                            invisible="not module_pos_payment_emulator"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>

