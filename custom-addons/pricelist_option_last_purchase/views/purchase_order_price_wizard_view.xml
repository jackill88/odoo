<odoo>

    <!-- ✅ LINE LIST VIEW (Odoo 19 uses <list>) -->
    <record id="view_pricelist_price_update_wizard_line_list" model="ir.ui.view">
        <field name="name">pricelist.price.update.wizard.line.list</field>
        <field name="model">pricelist.price.update.wizard.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Products">
                <field name="product_id"/>
                <field name="cost"/>
                <field name="current_price"/>
                <field name="markup_percent"/>
                <field name="new_price"/>

                <button name="action_save_price"
                        type="object"
                        string="Save"
                        icon="fa-save"/>
            </list>
        </field>
    </record>

    <!-- ✅ WIZARD FORM -->
    <record id="view_pricelist_price_update_wizard" model="ir.ui.view">
        <field name="name">pricelist.price.update.wizard.form</field>
        <field name="model">pricelist.price.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Pricelist">

                <group>
                    <field name="pricelist_id"/>
                </group>

                <!-- ✅ Reference the list view -->
                <field name="line_ids" mode="list" context="{'create': False}"/>
                <footer>
                    <button name="action_save_all"
                            type="object"
                            string="Save All"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>

            </form>
        </field>
    </record>

</odoo>