<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pos_payment_method_form_bpos1_terminal" model="ir.ui.view">
        <field name="name">pos.payment.method.form.bpos1.terminal</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='pos_payment_provider_cards']" position="after">
                <group class="o_wide_form" colspan="12" invisible="use_payment_terminal != 'bpos1_terminal'">
                    <notebook>
                        <page string="BPOS1 Terminal">
                            <group>
                                <field name="bpos1_terminal_merchant_id"/>
                                <field name="bpos1_terminal_device_id"/>
                            </group>
                            <group>
                                <field name="bpos1_terminal_store_code"/>
                                <field name="bpos1_terminal_token"/>
                            </group>
                            <group>
                                <field name="bpos1_terminal_secret" password="1"/>
                            </group>
                            <div class="o_form_label">
                                <p class="text-muted">This stubbed integration always reports success and surfaces the saved terminal credentials.</p>
                            </div>
                        </page>
                    </notebook>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
