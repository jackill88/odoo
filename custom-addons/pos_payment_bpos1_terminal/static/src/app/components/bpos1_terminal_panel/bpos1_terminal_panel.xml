<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_payment_bpos1_terminal.PaymentScreenBpos1TerminalPanel">
        <section t-if="hasTerminalLine" class="alert alert-info rounded-3 mt-2 p-3">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <strong>BPOS1 Terminal</strong>
                    <div class="text-muted small" t-esc="panelDescription"/>
                </div>
                <div class="text-end">
                    <span class="fs-5" t-esc="formattedAmount"/>
                    <div class="text-muted small">Remaining due</div>
                    <t t-if="orderRemaining">
                        <div class="text-muted small" t-esc="orderRemaining"/>
                    </t>
                </div>
            </div>
            <div class="row g-2 small">
                <div class="col-6">
                    <span class="text-muted">Merchant ID</span>
                    <div class="fw-bold" t-esc="terminalMerchantId"/>
                </div>
                <div class="col-6">
                    <span class="text-muted">Device ID</span>
                    <div class="fw-bold" t-esc="terminalDeviceId"/>
                </div>
                <div class="col-6">
                    <span class="text-muted">Store Code</span>
                    <div class="fw-bold" t-esc="terminalStoreCode"/>
                </div>
                <div class="col-6">
                    <span class="text-muted">Token</span>
                    <div class="fw-bold" t-esc="terminalToken"/>
                </div>
                <div class="col-12">
                    <span class="text-muted">Secret</span>
                    <div class="fw-bold" t-esc="terminalSecretStatus"/>
                </div>
            </div>
        </section>
    </t>
</templates>
