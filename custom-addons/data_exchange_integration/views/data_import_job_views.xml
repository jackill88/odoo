<odoo>

    <!-- LIST VIEW -->
    <record id="view_data_import_job_list" model="ir.ui.view">
        <field name="name">data.import.job.list</field>
        <field name="model">data.import.job</field>
        <field name="arch" type="xml">
            <list string="Import Jobs">
                <field name="id"/>
                <field name="state"/>
                <field name="source_type"/>
                <field name="file_name"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_data_import_job_form" model="ir.ui.view">
        <field name="name">data.import.job.form</field>
        <field name="model">data.import.job</field>
        <field name="arch" type="xml">
            <form string="Import Job">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,processing,done,failed,discarded"/>
                </header>

                <sheet>
                    <group>
                        <field name="source_type"/>
                        <field name="file_name"/>
                    </group>

                    <group string="Execution">
                        <field name="attempt_count"/>
                        <field name="max_attempts"/>
                        <field name="next_attempt_at"/>
                        <field name="locked_at"/>
                    </group>

                    <group string="Execution log">
                        <field name="log"/>
                    </group>

                    <group string="Errors">
                        <field name="last_error"/>
                    </group>

                    <notebook>

                        <page string="Payload">
                            <field name="payload" widget="json"/>
                        </page>

                        <page string="File">
                            <field name="file_data" filename="file_name"/>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_data_import_job" model="ir.actions.act_window">
        <field name="name">Import Jobs</field>
        <field name="res_model">data.import.job</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>