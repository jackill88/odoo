<odoo>

    <!-- LIST VIEW -->
    <record id="view_s3_config_list" model="ir.ui.view">
        <field name="name">data.import.s3.config.list</field>
        <field name="model">data.import.s3.config</field>
        <field name="arch" type="xml">
            <list string="S3 Configurations">
                <field name="name"/>
                <field name="key"/>
                <field name="endpoint"/>
                <field name="access_key"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_s3_config_form" model="ir.ui.view">
        <field name="name">data.import.s3.config.form</field>
        <field name="model">data.import.s3.config</field>
        <field name="arch" type="xml">
            <form string="s3 Configuration">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="key"/>
                    </group>

                    <group string="Connection">
                        <field name="endpoint"/>
                        <field name="access_key"/>
                        <field name="secret_key" password="True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_s3_config" model="ir.actions.act_window">
        <field name="name">S3 Configurations</field>
        <field name="res_model">data.import.s3.config</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>