<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="data_exchange_pos_order_form_extension" model="ir.ui.view">
        <field name="name">pos.order.form.data.exchange.extension</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_information']" position="inside">
                <field name="data_exchange_external_id" readonly="1"/>
                <field name="data_exchange_processed" readonly="0"/>
            </xpath>
        </field>
    </record>

    <record model="ir.actions.server" id="pos_order_data_exchange_mark_as_not_processed">
        <field name="name">Data Exchange: mark as not processed</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="group_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        <field name="binding_model_id" ref="point_of_sale.model_pos_order" />
        <field name="state">code</field>
        <field name="binding_view_types">list,kanban,form</field>
        <field name="code">
if records:
    action = records.action_pos_order_data_exchange_mark_as_not_processed()
        </field>
    </record>

</odoo>
