<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-inherit="point_of_sale.PosPaymentProviderCards" t-inherit-mode="extension">
        <xpath expr="//img[contains(@t-att-src, '/point_of_sale/static/img/providers/')]" position="attributes">
            <attribute name="t-att-src">
                provider.selection === 'emulator'
                    ? '/pos_payment_emulator/static/img/providers/emulator.svg'
                    : `/point_of_sale/static/img/providers/${provider.selection}.png`
            </attribute>
        </xpath>
    </t>
</templates>

