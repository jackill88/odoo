<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_weighted_goods_filter_list" model="ir.ui.view">
        <field name="name">weighted.goods.filter.list</field>
        <field name="type">list</field>
        <field name="model">weighted.goods.filter</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_category_id"/>
                <field name="only_weighted_goods"/>
                <field name="product_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_weighted_goods_filter_form" model="ir.ui.view">
        <field name="name">weighted.goods.filter.form</field>
        <field name="model">weighted.goods.filter</field>
        <field name="arch" type="xml">
            <form string="Weighted Goods Filter">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description" colspan="2"/>
                        </group>
                    </group>
                    <group>
                        <field name="product_category_id"/>
                        <field name="product_attribute_value_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="only_weighted_goods"/>
                        <field name="product_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="additional_product_template_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Point of Sale">
                            <field name="pos_config_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_weighted_goods_filter" model="ir.actions.act_window">
        <field name="name">Weighted goods filters</field>
        <field name="res_model">weighted.goods.filter</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_weighted_goods_filter_list"/>
        <field name="context">{'default_active': True}</field>
    </record>

    <menuitem id="menu_weighted_goods_filter"
        name="Weighted goods filters"
        parent="point_of_sale.menu_point_config_product"
        action="action_weighted_goods_filter"
        sequence="15"
        groups="point_of_sale.group_pos_manager"/>
</odoo>
