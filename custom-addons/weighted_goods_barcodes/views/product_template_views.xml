<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_weighted_goods" model="ir.ui.view">
        <field name="name">product.template.form.weighted.goods.barcode</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']" position="after">
                <page string="Weighted goods: barcodes" name="weighted_goods_barcode" invisible="not available_in_pos">
                    <group>
                        <group>
                            <field name="is_weighted_bc"/>
                            <field name="weighted_bc_plu" modifiers='{"invisible": [["is_weighted_bc", "=", false]]}'/>
                        </group>
                        <group string="Nomenclature" colspan="2">
                            <div class="o_form_label">
                                The scanned EAN13 barcode must match the weighted prefix defined on the PoS.
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
