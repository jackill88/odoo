<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_weighted_goods" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.weighted.goods</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='barcode_scanner']" position="after">
                <setting string="Weighted goods" help="Configure the weighted goods barcode prefix for this PoS.">
                    <div class="row">
                        <label class="col-lg-4 o_light_label" string="Weighted barcode prefix" for="pos_weighted_goods_barcode_prefix"/>
                        <field name="pos_weighted_goods_barcode_prefix" class="col"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
