<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pos_payment_method_form_bpos1" model="ir.ui.view">
        <field name="name">pos.payment.method.form.bpos1</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='pos_payment_provider_cards']" position="after">
                <group class="o_wide_form" colspan="12" invisible="use_payment_terminal != 'bpos1'">
                    <notebook>
                        <page string="BPOS1">
                            <div class="o_form_label">
                                BPOS1 terminal connection is configured at Point of Sale settings (Fiscal Service Integration).
                            </div>
                        </page>
                    </notebook>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
