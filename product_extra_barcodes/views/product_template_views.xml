<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_data_exchange" model="ir.ui.view">
        <field name="name">product.template.form.extra.barcodes</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']" position="after">
                <page string="Extra barcodes" name="extra_barcodes">
                    <group>
                        <group string="Extra Barcodes" colspan="2">
                            <div class="o_form_label">
                                Extra barcodes that can be used for product search
                            </div>
                        </group>
                        <group>
                            <field name="product_extra_barcode_ids">
                                <list string="Extra barcodes" editable="bottom">
                                    <field name="extra_barcode"/>
                                    <field name="is_active"/>
                                </list>
                            </field>
                        </group>

                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
